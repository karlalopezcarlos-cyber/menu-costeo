generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  OWNER
  STAFF
}

/// Secciones de la app que se pueden habilitar/deshabilitar por usuario STAFF (los OWNER siempre
/// tienen acceso completo, sin importar este catalogo).
enum Panel {
  DASHBOARD
  PRODUCTS
  PURCHASES
  WASTE
  RECIPES
  PRODUCTION
  INVENTORY
  AUDIT
  ORDERS
  SALES
  MENU_ENGINEERING
  SETTINGS
  PAYMENTS
  REQUISITIONS
  PLANNING
  STORE_ORDERS
}

/// Agrupador usado en el Estado de Resultados para desglosar ventas/costos en 3 columnas.
/// Categorias sin grupo asignado (null) se consolidan bajo Miscelaneos en ese reporte.
enum CategoryGroup {
  ALIMENTO
  BEBIDAS
  MISCELANEOS
}

enum Unit {
  G
  KG
  ML
  L
  OZ
  PIECE
}

enum ImportBatchStatus {
  DRAFT
  PROCESSED
}

enum ImportRowStatus {
  MATCHED
  PENDING
  IGNORED
  ERROR
}

enum PurchaseOrderStatus {
  OPEN
  RECEIVED
}

enum RecipeActivityType {
  CREATED
  ITEM_ADDED
  ITEM_REMOVED
  ARCHIVED
  UNARCHIVED
  UPDATED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Siguiente folio a asignar a un pedido nuevo (contador consecutivo por organizacion).
  nextOrderFolio Int @default(1)
  /// Siguiente folio a asignar a una compra nueva (contador consecutivo por organizacion).
  nextPurchaseFolio Int @default(1)
  /// Siguiente folio a asignar a una requisicion nueva (contador consecutivo por organizacion).
  nextRequisicionFolio Int @default(1)
  /// Siguiente folio a asignar a una produccion nueva (contador consecutivo por organizacion).
  nextProductionFolio Int @default(1)
  /// Siguiente folio a asignar a un ticket de venta nuevo (contador consecutivo por organizacion).
  nextSaleFolio Int @default(1)
  /// Siguiente folio a asignar a un pedido nuevo de la tienda en linea (contador consecutivo).
  nextStoreOrderFolio Int @default(1)
  /// Logo de la empresa, usado como marca de agua de fondo en todos los PDFs exportados. Se
  /// normaliza siempre a PNG (preserva transparencia) al subirlo, nunca JPEG como las fotos de
  /// receta, porque un fondo solido detras del logo se veria mal encima del contenido del PDF.
  logo             Bytes?
  logoMimeType     String?

  users             User[]
  products          Product[]
  productCategories ProductCategory[]
  recipeCategories  RecipeCategory[]
  purchases         Purchase[]
  suppliers         Supplier[]
  recipes           Recipe[]
  dishAliases       DishAlias[]
  dailySales        DailySale[]
  importBatches     ImportBatch[]
  recipeActivities  RecipeActivity[]
  inventoryCounts   InventoryCount[]
  wasteEntries      WasteEntry[]
  purchaseOrders    PurchaseOrder[]
  productionEntries ProductionEntry[]
  auditComments     AuditComment[]
  productPresentations ProductPresentation[]
  inventoryCountItemChanges InventoryCountItemChange[]
  supplierPayments  SupplierPayment[]
  sucursales        Sucursal[]
  requisiciones     Requisicion[]
  saleTickets       SaleTicket[]
  planningRuns      PlanningRun[]
  storeOrders       StoreOrder[]

  @@map("organizations")
}

model ProductCategory {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  name           String
  group          CategoryGroup?
  createdAt      DateTime       @default(now())

  products Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("product_categories")
}

model RecipeCategory {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  name           String
  group          CategoryGroup?
  createdAt      DateTime       @default(now())

  recipes Recipe[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("recipe_categories")
}

/// Una sucursal opera como un mini-restaurante independiente (compras, ventas, recetas e
/// inventario propios); el catalogo de productos y los proveedores se comparten a nivel
/// Organization. El CEDIS es una sucursal mas, marcada con isCentral=true (no una entidad aparte),
/// para que las Requisiciones puedan ir de cualquier sucursal a cualquier otra sin caso especial.
model Sucursal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  /// Sucursal "matriz"/CEDIS de la organizacion. Se crea una automaticamente para cada
  /// organizacion existente al migrar; sirve como destino por default y para el backfill.
  isCentral      Boolean      @default(false)
  isActive       Boolean      @default(true)
  /// Slug unico (global, no solo por organizacion) para la URL publica de la tienda en linea de
  /// esta sucursal (ej. /store/mi-dark-kitchen). Nulo mientras no se configure.
  storeSlug      String?      @unique
  /// Si la tienda en linea esta habilitada para recibir pedidos publicos ahorita mismo.
  storeEnabled   Boolean      @default(false)
  /// Direccion de origen para calcular km de envio a domicilio (geocodificada a lat/lng al
  /// guardarse en Configuracion).
  businessAddress String?
  businessLat     Decimal?     @db.Decimal(10, 6)
  businessLng     Decimal?     @db.Decimal(10, 6)
  /// Cuota fija de envio, independiente de la distancia.
  deliveryBaseFee     Decimal  @default(0) @db.Decimal(10, 2)
  /// Precio por km recorrido (ruta real, no linea recta) que se suma a deliveryBaseFee.
  deliveryPricePerKm  Decimal  @default(0) @db.Decimal(10, 2)
  /// Pedido minimo (subtotal de platillos, sin contar el envio) para poder pedir a domicilio.
  deliveryMinOrder    Decimal  @default(0) @db.Decimal(12, 2)
  /// Distancia maxima (km, ruta real) a la que se acepta enviar a domicilio. 0 = sin limite.
  deliveryMaxKm       Decimal  @default(0) @db.Decimal(6, 2)
  /// Horarios de entrega (opcional): si deliverySlotsCount > 0, el cliente debe elegir uno de los
  /// horarios generados a partir de deliveryStartTime + deliverySlotMinutes x deliverySlotsCount
  /// (ej. inicio "14:00", cada 30 min, 4 horarios -> 14:00, 14:30, 15:00, 15:30). Cada horario
  /// admite hasta deliverySlotCapacity pedidos antes de bloquearse para nuevos clientes.
  deliveryStartTime    String?
  deliverySlotMinutes  Int      @default(30)
  deliverySlotsCount   Int      @default(0)
  deliverySlotCapacity Int      @default(1)
  /// Dias minimos de anticipacion que debe tener una fecha de StoreDeliveryDate para que el
  /// cliente la pueda elegir (ej. 7 = solo se puede pedir con una semana de anticipacion).
  deliveryLeadDays     Int      @default(0)
  createdAt      DateTime     @default(now())

  purchases         Purchase[]
  purchaseOrders    PurchaseOrder[]
  dailySales        DailySale[]
  recipes           Recipe[]
  inventoryCounts   InventoryCount[]
  wasteEntries      WasteEntry[]
  productionEntries ProductionEntry[]
  auditComments     AuditComment[]
  supplierPayments  SupplierPayment[]
  dishAliases       DishAlias[]
  importBatches     ImportBatch[]
  recipeActivities  RecipeActivity[]
  inventoryCountItemChanges InventoryCountItemChange[]
  requisicionesEnviadas   Requisicion[] @relation("RequisicionFrom")
  requisicionesRecibidas  Requisicion[] @relation("RequisicionTo")
  userAccess        UserSucursal[]
  saleTickets       SaleTicket[]
  planningRuns      PlanningRun[]
  storeOrders       StoreOrder[]
  storeDeliveryDates StoreDeliveryDate[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("sucursales")
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  hashedPassword String
  name           String?
  role           Role          @default(STAFF)
  /// Paneles habilitados para este usuario cuando role = STAFF. Los OWNER ven todo sin importar
  /// este campo.
  allowedPanels  Panel[]       @default([])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  purchasesCreated  Purchase[]        @relation("PurchaseCreatedBy")
  importBatches     ImportBatch[]     @relation("ImportBatchUploadedBy")
  recipeActivities  RecipeActivity[]
  inventoryCounts   InventoryCount[]  @relation("InventoryCountCreatedBy")
  wasteEntries      WasteEntry[]      @relation("WasteEntryCreatedBy")
  purchaseOrders    PurchaseOrder[]   @relation("PurchaseOrderCreatedBy")
  productionEntries ProductionEntry[] @relation("ProductionEntryCreatedBy")
  auditComments     AuditComment[]    @relation("AuditCommentCreatedBy")
  inventoryCountItemChanges InventoryCountItemChange[] @relation("InventoryCountItemChangeChangedBy")
  supplierPayments  SupplierPayment[] @relation("SupplierPaymentCreatedBy")
  requisiciones     Requisicion[] @relation("RequisicionCreatedBy")
  saleTickets       SaleTicket[]  @relation("SaleTicketCreatedBy")
  /// Sucursales a las que este usuario tiene acceso cuando role = STAFF (puede entrar y cambiar
  /// entre ellas con el mismo selector que usa OWNER). Un OWNER ignora esta lista: siempre ve
  /// todas las sucursales de su organizacion sin importar que haya filas aqui.
  sucursales        UserSucursal[]

  @@index([organizationId])
  @@map("users")
}

/// Acceso de un usuario STAFF a una sucursal especifica. Un mismo usuario puede tener varias filas
/// (acceso a varias sucursales) y cambiar entre ellas con el selector del layout, igual que ya
/// podia hacer un OWNER entre todas las de su organizacion.
model UserSucursal {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, sucursalId])
  @@index([userId])
  @@index([sucursalId])
  @@map("user_sucursales")
}

model Product {
  id                       String       @id @default(cuid())
  organizationId           String
  organization             Organization     @relation(fields: [organizationId], references: [id])
  name                     String
  categoryId               String?
  category                 ProductCategory? @relation(fields: [categoryId], references: [id])
  baseUnit                 Unit
  /// % de rendimiento neto (100 = sin merma). Ej. cilantro con 20% de merma -> 80.
  /// El costo unitario de cada compra se divide entre este factor para costear con el neto aprovechable.
  yieldPercentage          Decimal      @default(100) @db.Decimal(5, 2)
  currentUnitCost          Decimal      @default(0) @db.Decimal(14, 6)
  currentUnitCostUpdatedAt DateTime?
  /// Stock objetivo (par level) en la unidad base del producto. 0 = sin objetivo configurado,
  /// no aparece en la seccion de pedidos sugeridos.
  targetStock              Decimal      @default(0) @db.Decimal(14, 4)
  /// Presentacion de compra fija opcional (ej. "Botella" = 750 ML, en la unidad base del
  /// producto). Permite comprar/contar por pieza (1 botella) mientras el sistema seguro sigue
  /// costeando e inventariando en la unidad base (ml). Null = no aplica, se compra/cuenta
  /// directo en la unidad base.
  presentationUnitLabel    String?
  presentationUnitQty      Decimal?     @db.Decimal(14, 4)
  archivedAt               DateTime?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  purchases           Purchase[]
  recipeItems         RecipeItem[]
  inventoryCountItems InventoryCountItem[]
  wasteEntries        WasteEntry[]
  purchaseOrderItems  PurchaseOrderItem[]
  auditComments       AuditComment[]
  presentations       ProductPresentation[]
  inventoryCountItemChanges InventoryCountItemChange[]
  requisicionItems    RequisicionItem[]
  planningRunItems    PlanningRunItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("products")
}

/// Catalogo de presentaciones nombradas de un producto (ej. "Lata 2.75kg" = 2.75 KG, "Bulto 25kg" =
/// 25 KG). Permite capturar Pedidos/Compras/Inventario en piezas ("2 latas") y que el sistema calcule
/// solo la cantidad equivalente en la unidad base del producto. Independiente del campo unico
/// presentationUnitLabel/Qty de Product (ese es para el caso de botellas/OZ en recetas).
model ProductPresentation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  label          String
  quantity       Decimal      @db.Decimal(14, 4)
  unit           Unit
  createdAt      DateTime     @default(now())

  @@unique([productId, label])
  @@index([organizationId, productId])
  @@map("product_presentations")
}

model Purchase {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  sucursalId        String
  sucursal          Sucursal     @relation(fields: [sucursalId], references: [id])
  /// Folio unico consecutivo por organizacion (ej. COM-0042), para identificar la compra.
  folio             Int
  productId         String
  product           Product      @relation(fields: [productId], references: [id])
  purchaseDate      DateTime     @db.Date
  presentationLabel String
  presentationQty   Decimal      @db.Decimal(14, 4)
  presentationUnit  Unit
  totalPrice        Decimal      @db.Decimal(12, 2)
  computedUnitCost  Decimal      @db.Decimal(14, 6)
  supplierId        String?
  supplier          Supplier?    @relation(fields: [supplierId], references: [id])
  createdByUserId   String?
  createdBy         User?        @relation("PurchaseCreatedBy", fields: [createdByUserId], references: [id])
  createdAt         DateTime     @default(now())
  /// Nota auto-generada cuando esta compra viene de un pedido y lo recibido no coincide con lo
  /// que se esperaba en esa entrega (ej. "Pedido PED-0005: se esperaban 50 KG, llegaron 45 KG").
  note              String?
  /// Comentario libre capturado por el usuario para este renglon de la compra (ej. "llego danado").
  comment           String?

  /// El folio ya no es unico por renglon: todos los productos capturados en una misma compra
  /// (un solo envio del formulario) comparten el mismo folio.
  @@index([organizationId, folio])
  @@index([organizationId, productId, purchaseDate])
  @@index([organizationId, purchaseDate])
  @@index([sucursalId, purchaseDate])
  @@map("purchases")
}

/// Proveedor informativo: se captura opcionalmente en cada compra para poder comparar precios
/// entre proveedores del mismo producto. No bloquea ni obliga la captura de compras.
model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  /// Telefono y correo principales (se usan para enviar el pedido por WhatsApp/email). Telefonos
  /// y correos adicionales se guardan por separado en SupplierPhone/SupplierEmail.
  phone          String?
  email          String?
  /// Campos informativos, ninguno obligatorio: no afectan costeo ni calculos, solo se muestran
  /// en la ficha del proveedor y en el Excel de exportacion.
  rfc            String?
  businessName   String?
  address        String?
  paymentMethod  String?
  contactName    String?
  bankInfo       String?
  creditDays     Int?
  notes          String?
  /// Un proveedor inactivo deja de aparecer como opcion al capturar Compras o Pedidos nuevos,
  /// pero su historial (compras, pedidos, pagos ya registrados) no se toca ni se oculta.
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  purchases        Purchase[]
  purchaseOrders   PurchaseOrder[]
  supplierPayments SupplierPayment[]
  phones           SupplierPhone[]
  emails           SupplierEmail[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("suppliers")
}

/// Numero adicional de contacto de un proveedor (el principal vive en Supplier.phone).
model SupplierPhone {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  phone      String
  label      String?
  createdAt  DateTime @default(now())

  @@index([supplierId])
  @@map("supplier_phones")
}

/// Correo adicional de contacto de un proveedor (el principal vive en Supplier.email).
model SupplierEmail {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  email      String
  label      String?
  createdAt  DateTime @default(now())

  @@index([supplierId])
  @@map("supplier_emails")
}

/// Un abono (pago parcial o total) a un folio de compra de un proveedor. Un folio puede recibir
/// varios abonos a lo largo del tiempo hasta cubrir su total; el saldo de un proveedor es el
/// total comprado menos la suma de todos sus abonos. `folio` nullable solo por compatibilidad con
/// adelantos antiguos sin folio (ya no se crean nuevos asi: todo abono nuevo debe ligarse a un folio).
model SupplierPayment {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  sucursalId      String
  sucursal        Sucursal     @relation(fields: [sucursalId], references: [id])
  supplierId      String
  supplier        Supplier     @relation(fields: [supplierId], references: [id])
  folio           Int?
  amount          Decimal      @db.Decimal(12, 2)
  paidDate        DateTime     @db.Date
  note            String?
  createdByUserId String?
  createdBy       User?        @relation("SupplierPaymentCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime     @default(now())

  @@index([organizationId, supplierId])
  @@index([sucursalId, supplierId])
  @@map("supplier_payments")
}

model Recipe {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  sucursalId     String
  sucursal       Sucursal        @relation(fields: [sucursalId], references: [id])
  /// Cuando esta receta se creo por clonado automatico desde la receta de la sucursal principal
  /// (ver createRecipe), apunta a esa receta original. Puramente informativo/de rastro: nunca se
  /// usa para recalcular ni resincronizar; una vez clonada, cada copia es independiente y editable
  /// sin afectar al original ni a las demas copias.
  sourceRecipeId String?
  sourceRecipe   Recipe?         @relation("RecipeSource", fields: [sourceRecipeId], references: [id], onDelete: SetNull)
  copies         Recipe[]        @relation("RecipeSource")
  name           String
  categoryId     String?
  category       RecipeCategory? @relation(fields: [categoryId], references: [id])
  yieldQty       Decimal      @db.Decimal(14, 4)
  yieldUnit      Unit
  isMenuItem     Boolean      @default(false)
  sellingPrice   Decimal?     @db.Decimal(12, 2)
  instructions   String?
  /// Descripcion para clientes en la tienda en linea (que es el platillo), distinta de
  /// `instructions` (que es el procedimiento interno de cocina).
  storeDescription String?
  photo          Bytes?
  photoMimeType  String?
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items               RecipeItem[]          @relation("RecipeItems")
  usedAsIngredient    RecipeItem[]          @relation("SubRecipeUsage")
  dishAliases         DishAlias[]
  dailySales          DailySale[]
  activities          RecipeActivity[]
  inventoryCountItems InventoryCountItem[]
  productionEntries   ProductionEntry[]
  auditComments       AuditComment[]
  inventoryCountItemChanges InventoryCountItemChange[]
  requisicionItemsAsOrigin RequisicionItem[] @relation("RequisicionItemSubRecipe")
  requisicionItemsAsDest   RequisicionItem[] @relation("RequisicionItemDestSubRecipe")
  wasteEntries             WasteEntry[]
  saleTicketItems          SaleTicketItem[]
  planningRunItems         PlanningRunItem[]
  storeOrderItems          StoreOrderItem[]

  @@unique([sucursalId, name])
  @@index([organizationId])
  @@index([sucursalId])
  @@map("recipes")
}

model RecipeActivity {
  id              String             @id @default(cuid())
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id])
  sucursalId      String
  sucursal        Sucursal           @relation(fields: [sucursalId], references: [id])
  recipeId        String
  recipe          Recipe             @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  type            RecipeActivityType
  message         String
  createdByUserId String?
  createdBy       User?              @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime           @default(now())

  @@index([recipeId, createdAt])
  @@map("recipe_activities")
}

/// Polimorfico: exactamente uno de productId / subRecipeId debe estar presente.
/// El CHECK constraint real (XOR + no auto-referencia) se agrega en una migracion SQL manual
/// porque Prisma no soporta CHECK constraints declarativos.
model RecipeItem {
  id          String   @id @default(cuid())
  recipeId    String
  recipe      Recipe   @relation("RecipeItems", fields: [recipeId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  subRecipeId String?
  subRecipe   Recipe?  @relation("SubRecipeUsage", fields: [subRecipeId], references: [id])
  quantity    Decimal  @db.Decimal(14, 4)
  unit        Unit
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([recipeId])
  @@index([productId])
  @@index([subRecipeId])
  @@map("recipe_items")
}

/// Mapeo nombre-externo (reporte de POS) -> Receta, con normalizacion para matching tolerante.
/// Si recipeId es null e ignored=true, ese nombre nunca es un platillo (propinas, descuentos, etc.).
model DishAlias {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  sucursalId     String
  sucursal       Sucursal     @relation(fields: [sucursalId], references: [id])
  externalName   String
  normalizedName String
  recipeId       String?
  recipe         Recipe?      @relation(fields: [recipeId], references: [id])
  ignored        Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([sucursalId, normalizedName])
  @@index([organizationId])
  @@map("dish_aliases")
}

/// Una venta por dia y por receta (reemplaza el antiguo agregado mensual). "source" distingue
/// captura manual de datos venidos de una importacion de Excel.
model DailySale {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  sucursalId     String
  sucursal       Sucursal     @relation(fields: [sucursalId], references: [id])
  recipeId       String
  recipe         Recipe       @relation(fields: [recipeId], references: [id])
  date           DateTime     @db.Date
  quantitySold   Decimal      @db.Decimal(12, 2)
  unitPrice      Decimal      @db.Decimal(12, 2)
  source         String       @default("manual")
  importBatchId  String?
  importBatch    ImportBatch? @relation(fields: [importBatchId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, recipeId, date])
  @@index([organizationId, date])
  @@index([sucursalId, date])
  @@map("daily_sales")
}

/// Un ticket de venta (mini punto de venta): un solo evento de cobro que puede incluir varios
/// platillos, con folio consecutivo y descargable como PDF. Al guardarse, cada renglon tambien se
/// suma al agregado diario en DailySale (recipe+fecha), para que Ingenieria de menu y Estado de
/// Resultados sigan funcionando sin cambios sobre ese mismo dato ya existente.
model SaleTicket {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  sucursalId      String
  sucursal        Sucursal     @relation(fields: [sucursalId], references: [id])
  folio           Int
  date            DateTime     @db.Date
  createdByUserId String?
  createdBy       User?        @relation("SaleTicketCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime     @default(now())
  /// Link de cobro generado en Mercado Pago (Checkout Pro) para mandarle al cliente. Se genera bajo
  /// demanda (boton "Generar link de pago" en el detalle del ticket) y se guarda aqui para no crear
  /// una preferencia nueva cada vez que se vuelve a abrir el ticket.
  paymentLink         String?
  paymentPreferenceId String?

  items SaleTicketItem[]

  @@index([organizationId, folio])
  @@index([sucursalId, date])
  @@map("sale_tickets")
}

model SaleTicketItem {
  id        String     @id @default(cuid())
  ticketId  String
  ticket    SaleTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe     @relation(fields: [recipeId], references: [id])
  quantity  Decimal    @db.Decimal(12, 2)
  unitPrice Decimal    @db.Decimal(12, 2)

  @@index([ticketId])
  @@index([recipeId])
  @@map("sale_ticket_items")
}

/// Un calculo de Proyeccion por PLU (lib/planning.ts), guardado para que la lista de "que producir /
/// que comprar" persista entre sesiones (ej. celular en mano en el super) hasta que el usuario
/// vuelva a calcular. Siempre se muestra el mas reciente de la sucursal; uno nuevo simplemente
/// vuelve el mas reciente, sin borrar los anteriores (mismo patron de snapshot que Purchase,
/// WasteEntry, ProductionEntry, etc.).
model PlanningRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  sucursalId     String
  sucursal       Sucursal     @relation(fields: [sucursalId], references: [id])
  /// JSON de [{recipeId, quantity}] capturado al calcular, para poder re-desplegar el mismo
  /// formulario de origen si se quiere ajustar y recalcular.
  targetsJson    String
  createdAt      DateTime     @default(now())

  items PlanningRunItem[]

  @@index([sucursalId, createdAt])
  @@map("planning_runs")
}

model PlanningRunItem {
  id            String      @id @default(cuid())
  planningRunId String
  planningRun   PlanningRun @relation(fields: [planningRunId], references: [id], onDelete: Cascade)
  /// "production" (subreceta a producir) o "purchase" (producto a comprar).
  itemType      String
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id])
  subRecipeId   String?
  subRecipe     Recipe?     @relation(fields: [subRecipeId], references: [id])
  /// Necesario total (bruto, antes de descontar existencia) al momento de calcular, para poder
  /// seguir mostrando "Necesario total" / "Existencia" aunque el inventario real siga cambiando
  /// despues -- es una fotografia del calculo, no un valor que se recalcule solo.
  grossQty      Decimal     @db.Decimal(14, 4)
  onHandQty     Decimal     @db.Decimal(14, 4)
  netQty        Decimal     @db.Decimal(14, 4)
  unit          Unit
  comment       String?
  /// Marcado como "ya lo hice" mientras se usa como lista de super/produccion; tambien funciona
  /// como la seleccion para "Crear pedido" / "Registrar produccion" desde la proyeccion.
  completed     Boolean     @default(false)
  sortOrder     Int         @default(0)

  @@index([planningRunId])
  @@map("planning_run_items")
}

/// Un pedido hecho por un cliente externo desde la tienda en linea publica (Fase 1: solo recoger
/// en tienda, sin pago en linea todavia -- eso llega en una fase posterior). Aparece en el panel
/// interno "Pedidos en linea" para que el staff lo vaya marcando como atendido, y sus renglones se
/// pueden cargar como punto de partida en la Proyeccion por PLU.
model StoreOrder {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  sucursalId      String
  sucursal        Sucursal     @relation(fields: [sucursalId], references: [id])
  folio           Int
  customerName    String
  customerPhone   String?
  /// "pickup" (unico disponible en Fase 1) o "delivery" (fase posterior, con costo por km).
  fulfillmentType String       @default("pickup")
  /// "pending" (recien llegado) | "fulfilled" (ya se atendio) | "cancelled".
  status          String       @default("pending")
  /// "pickup_cash" (paga al recoger) o "card_online" (pago con tarjeta en linea via Mercado Pago).
  paymentMethod   String       @default("pickup_cash")
  /// "unpaid" (paga al recoger, no aplica) | "pending" (link generado, esperando confirmacion del
  /// webhook) | "paid" (Mercado Pago confirmo el cobro) | "failed".
  paymentStatus   String       @default("unpaid")
  paymentPreferenceId String?
  paymentLink     String?
  /// Solo cuando fulfillmentType = "delivery": direccion capturada por el cliente, geocodificada,
  /// distancia real por calles desde el negocio, y la cuota de envio ya calculada (incluida en
  /// total). requestedDeliveryDate es la fecha que el cliente eligio de las disponibles.
  deliveryAddress     String?
  deliveryLat         Decimal?  @db.Decimal(10, 6)
  deliveryLng         Decimal?  @db.Decimal(10, 6)
  deliveryDistanceKm  Decimal?  @db.Decimal(8, 2)
  deliveryFee         Decimal   @default(0) @db.Decimal(10, 2)
  requestedDeliveryDate DateTime? @db.Date
  /// Horario elegido dentro de los generados por la config de la sucursal (ej. "14:30"), si esa
  /// sucursal tiene horarios de entrega configurados.
  requestedDeliveryTime String?
  total           Decimal      @db.Decimal(12, 2)
  createdAt       DateTime     @default(now())
  /// Cuando el staff le dio click a "Confirmar pedido" (envia WhatsApp al cliente avisando que se
  /// recibio su pedido). Distinto de status="fulfilled", que es cuando el pedido ya se completo.
  confirmedAt     DateTime?
  /// Comentarios generales del cliente (instrucciones especiales, alergias, etc).
  comment         String?
  /// Como se reparte el pedido si es para varias personas, ej. "MARIANA: 2 de camaron + 1 de
  /// pollo\nJORGE: 5 de camaron". Texto libre, se muestra aparte de comment para que el staff lo
  /// vea claro al armar los paquetes.
  packagingNotes  String?

  items StoreOrderItem[]

  @@index([organizationId, folio])
  @@index([sucursalId, status])
  @@map("store_orders")
}

/// Fecha especifica en la que el dueno marco que SI hay entregas a domicilio disponibles (calendario
/// que el va capturando el mismo, no un patron recurrente de dias de la semana).
model StoreDeliveryDate {
  id         String   @id @default(cuid())
  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  createdAt  DateTime @default(now())

  @@unique([sucursalId, date])
  @@index([sucursalId, date])
  @@map("store_delivery_dates")
}

model StoreOrderItem {
  id           String     @id @default(cuid())
  storeOrderId String
  storeOrder   StoreOrder @relation(fields: [storeOrderId], references: [id], onDelete: Cascade)
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id])
  quantity     Decimal    @db.Decimal(12, 2)
  /// Precio de venta al momento del pedido (snapshot; si el precio del platillo cambia despues, el
  /// pedido ya hecho no se mueve).
  unitPrice    Decimal    @db.Decimal(12, 2)

  @@index([storeOrderId])
  @@index([recipeId])
  @@map("store_order_items")
}

model ImportBatch {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  sucursalId       String
  sucursal         Sucursal          @relation(fields: [sucursalId], references: [id])
  fileName         String
  headers          Json
  rawRows          Json
  columnMapping    Json?
  status           ImportBatchStatus @default(DRAFT)
  rowsTotal        Int               @default(0)
  rowsMatched      Int               @default(0)
  rowsPending      Int               @default(0)
  uploadedByUserId String?
  uploadedBy       User?             @relation("ImportBatchUploadedBy", fields: [uploadedByUserId], references: [id])
  createdAt        DateTime          @default(now())

  rows       ImportRow[]
  dailySales DailySale[]

  @@index([organizationId])
  @@map("import_batches")
}

model ImportRow {
  id              String          @id @default(cuid())
  importBatchId   String
  importBatch     ImportBatch     @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  rawName         String
  normalizedName  String
  date            DateTime?       @db.Date
  quantitySold    Decimal         @db.Decimal(12, 2)
  unitPrice       Decimal         @db.Decimal(12, 2)
  status          ImportRowStatus @default(PENDING)
  matchedRecipeId String?
  errorMessage    String?
  createdAt       DateTime        @default(now())

  @@index([importBatchId])
  @@map("import_rows")
}

/// Un conteo fisico de inventario en una fecha dada. Cada linea (InventoryCountItem) guarda el
/// costo unitario vigente AL MOMENTO DEL CONTEO (no se recalcula despues), igual que el costo
/// de una compra: es un valor historico, no una vista en vivo.
model InventoryCount {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  sucursalId      String
  sucursal        Sucursal @relation(fields: [sucursalId], references: [id])
  date            DateTime @db.Date
  createdByUserId String?
  createdBy       User?    @relation("InventoryCountCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items         InventoryCountItem[]
  auditComments AuditComment[]
  itemChanges   InventoryCountItemChange[]

  @@index([organizationId, date])
  @@index([sucursalId, date])
  @@map("inventory_counts")
}

/// Polimorfico: exactamente uno de productId / subRecipeId debe estar presente (mismo patron
/// que RecipeItem). unitCost es el costo unitario congelado al momento de contar.
model InventoryCountItem {
  id               String         @id @default(cuid())
  inventoryCountId String
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?       @relation(fields: [productId], references: [id])
  subRecipeId      String?
  subRecipe        Recipe?        @relation(fields: [subRecipeId], references: [id])
  quantity         Decimal        @db.Decimal(14, 4)
  unit             Unit
  unitCost         Decimal        @db.Decimal(14, 6)
  /// "net" (costo con rendimiento aplicado, default) o "gross" (costo de compra, sin descontar
  /// la merma; ej. aguacate entero sin pelar). Solo aplica a productos con rendimiento < 100%.
  costBasis        String         @default("net")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([inventoryCountId, productId])
  @@unique([inventoryCountId, subRecipeId])
  @@index([inventoryCountId])
  @@map("inventory_count_items")
}

/// Bitacora de cambios a las cantidades capturadas de un conteo: cada vez que se guarda (manual o
/// autoguardado) un valor distinto al que ya estaba, se registra el antes/despues, quien y cuando.
/// Permite detectar si alguien modifica un conteo despues de capturado originalmente. Polimorfico
/// (productId xor subRecipeId), mismo patron que InventoryCountItem.
model InventoryCountItemChange {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])
  sucursalId       String
  sucursal         Sucursal       @relation(fields: [sucursalId], references: [id])
  inventoryCountId String
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?       @relation(fields: [productId], references: [id])
  subRecipeId      String?
  subRecipe        Recipe?        @relation(fields: [subRecipeId], references: [id])
  previousQuantity Decimal?       @db.Decimal(14, 4)
  newQuantity      Decimal        @db.Decimal(14, 4)
  changedByUserId  String?
  changedBy        User?          @relation("InventoryCountItemChangeChangedBy", fields: [changedByUserId], references: [id])
  changedAt        DateTime       @default(now())

  @@index([organizationId, inventoryCountId, changedAt])
  @@map("inventory_count_item_changes")
}

/// Comentario explicando una variacion (faltante/sobrante) encontrada en la auditoria de
/// inventario, para un producto o subreceta, en un conteo final especifico. Polimorfico
/// (productId xor subRecipeId), igual patron que InventoryCountItem.
model AuditComment {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])
  sucursalId      String
  sucursal        Sucursal       @relation(fields: [sucursalId], references: [id])
  finalCountId    String
  finalCount      InventoryCount @relation(fields: [finalCountId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?       @relation(fields: [productId], references: [id])
  subRecipeId     String?
  subRecipe       Recipe?        @relation(fields: [subRecipeId], references: [id])
  comment         String
  createdByUserId String?
  createdBy       User?          @relation("AuditCommentCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([finalCountId, productId])
  @@unique([finalCountId, subRecipeId])
  @@index([finalCountId])
  @@map("audit_comments")
}

/// Registro de merma: un producto desechado/echado a perder en una fecha, con su costo
/// congelado al momento de capturarlo (igual que una compra) y un comentario libre para la razon.
model WasteEntry {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  sucursalId      String
  sucursal        Sucursal     @relation(fields: [sucursalId], references: [id])
  productId       String?
  product         Product?     @relation(fields: [productId], references: [id])
  /// Subreceta o PLU (platillo de menu) mermado completo, mutuamente excluyente con productId.
  /// Un PLU permite registrar la perdida de un platillo ya preparado (ej. se cayo, se quemo).
  subRecipeId     String?
  subRecipe       Recipe?      @relation(fields: [subRecipeId], references: [id])
  date            DateTime     @db.Date
  quantity        Decimal      @db.Decimal(14, 4)
  unit            Unit
  unitCost        Decimal      @db.Decimal(14, 6)
  /// "net" (costo con rendimiento aplicado, default) o "gross" (costo de compra, sin descontar
  /// la merma; ej. aguacate entero sin pelar). Solo aplica a productos con rendimiento < 100%.
  costBasis       String       @default("net")
  comment         String?
  createdByUserId String?
  createdBy       User?        @relation("WasteEntryCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime     @default(now())

  @@index([organizationId, date])
  @@index([organizationId, productId])
  @@index([subRecipeId])
  @@index([sucursalId, date])
  @@map("waste_entries")
}

/// Pedido a proveedor generado a partir de los faltantes (stock objetivo - stock actual).
/// OPEN = pendiente de recibir (los productos que contiene se marcan como "ya en pedido" en la
/// pantalla de faltantes para no duplicar); RECEIVED = ya llego, libera esos productos de nuevo.
model PurchaseOrder {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id])
  sucursalId      String
  sucursal        Sucursal            @relation(fields: [sucursalId], references: [id])
  /// Folio consecutivo por organizacion (ej. 7 -> "PED-0007"), asignado atomicamente al crear.
  folio           Int
  status          PurchaseOrderStatus @default(OPEN)
  supplierId      String?
  supplier        Supplier?           @relation(fields: [supplierId], references: [id])
  comment         String?
  createdByUserId String?
  createdBy       User?               @relation("PurchaseOrderCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime            @default(now())
  receivedAt      DateTime?

  items PurchaseOrderItem[]

  @@unique([organizationId, folio])
  @@index([organizationId, status])
  @@index([sucursalId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  /// Texto libre, autogenerado a partir de la presentacion elegida al capturar la cantidad (o de
  /// la unidad base si se captura libre). Ya no se edita a mano, ver Cantidad en la UI.
  presentationLabel String
  quantity        Decimal       @db.Decimal(14, 4)
  /// Cantidad que realmente llego al marcar el pedido como recibido. Null mientras el pedido siga
  /// abierto, o en pedidos recibidos antes de que existiera este campo (se asumen completos).
  receivedQuantity Decimal?     @db.Decimal(14, 4)
  /// Nota opcional por renglon (ej. "marca X", "urgente").
  comment         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([purchaseOrderId, productId])
  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

/// Registro de produccion: cuanto de una subreceta se preparo en una fecha. Su costo unitario
/// (costo de receta / rendimiento) se congela al momento de capturar, igual que una compra.
/// Alimenta la auditoria de inventario: descuenta los ingredientes que contiene (productos y
/// sub-subrecetas) y suma al teorico de la subreceta producida.
model ProductionEntry {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  sucursalId      String
  sucursal        Sucursal     @relation(fields: [sucursalId], references: [id])
  /// Folio unico consecutivo por organizacion (ej. PROD-0001): todas las filas capturadas en un
  /// mismo envio del formulario de "Registrar produccion" comparten el mismo folio.
  folio           Int
  subRecipeId     String
  subRecipe       Recipe       @relation(fields: [subRecipeId], references: [id])
  date            DateTime     @db.Date
  quantity        Decimal      @db.Decimal(14, 4)
  unit            Unit
  unitCost        Decimal      @db.Decimal(14, 6)
  comment         String?
  createdByUserId String?
  createdBy       User?        @relation("ProductionEntryCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime     @default(now())

  @@index([organizationId, date])
  @@index([organizationId, subRecipeId])
  @@index([organizationId, folio])
  @@index([sucursalId, date])
  @@map("production_entries")
}

/// Movimiento de productos entre dos sucursales de la misma organizacion (ej. el CEDIS surte a un
/// restaurante). Es de un solo paso: al guardarse, ya se considera enviado/recibido de inmediato
/// (sin confirmacion posterior) — descuenta el inventario teorico de fromSucursal y lo suma al de
/// toSucursal en la Auditoria/Kardex de cada una.
model Requisicion {
  id              String            @id @default(cuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id])
  /// Folio consecutivo por organizacion (ej. 7 -> "REQ-0007"), asignado atomicamente al crear.
  folio           Int
  fromSucursalId  String
  fromSucursal    Sucursal          @relation("RequisicionFrom", fields: [fromSucursalId], references: [id])
  toSucursalId    String
  toSucursal      Sucursal          @relation("RequisicionTo", fields: [toSucursalId], references: [id])
  date            DateTime          @db.Date
  note            String?
  createdByUserId String?
  createdBy       User?             @relation("RequisicionCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime          @default(now())

  items RequisicionItem[]

  @@unique([organizationId, folio])
  @@index([organizationId, fromSucursalId, date])
  @@index([organizationId, toSucursalId, date])
  @@map("requisiciones")
}

model RequisicionItem {
  id            String      @id @default(cuid())
  requisicionId String
  requisicion   Requisicion @relation(fields: [requisicionId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id])
  /// Subreceta de la sucursal ORIGEN cuyo inventario se descuenta (mutuamente excluyente con
  /// productId). Cada sucursal tiene su propia copia independiente de cada subreceta, por eso
  /// tambien se guarda `destSubRecipeId` con la copia equivalente en la sucursal destino.
  subRecipeId     String?
  subRecipe       Recipe?     @relation("RequisicionItemSubRecipe", fields: [subRecipeId], references: [id])
  /// Copia de esta subreceta en la sucursal DESTINO (resuelta al crear la requisicion via
  /// clonado/nombre), usada para acreditar el inventario/kardex del lado que recibe. Null si el
  /// renglon es un producto (el catalogo de productos ya es compartido entre sucursales).
  destSubRecipeId String?
  destSubRecipe   Recipe?     @relation("RequisicionItemDestSubRecipe", fields: [destSubRecipeId], references: [id])
  quantity      Decimal     @db.Decimal(14, 4)
  unit          Unit
  /// Costo unitario congelado al momento de enviar (de la sucursal de origen), mismo patron que
  /// Purchase/WasteEntry/ProductionEntry: nunca se recalcula despues.
  unitCost      Decimal     @db.Decimal(14, 6)

  @@index([requisicionId])
  @@index([productId])
  @@index([subRecipeId])
  @@index([destSubRecipeId])
  @@map("requisicion_items")
}
